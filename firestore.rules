rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function sameFamily(familyId) {
      // Membership is stored as families/{familyId}/family_members/{uid}
      // (see addFamilyMember in family-operations.ts).
      return signedIn() &&
        exists(/databases/$(database)/documents/families/$(familyId)/family_members/$(request.auth.uid));
    }

    match /profiles/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /user_roles/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /families/{familyId} {
      // Any signed-in user can look up a family (needed to join by invite code
      // and to load your own family); the doc holds only a name + invite code.
      // Mutations stay restricted to members.
      allow read: if signedIn();
      allow create: if signedIn();
      allow update: if sameFamily(familyId);

      // Membership subcollection: read if you're in the family; a user may
      // create only their OWN membership doc (join/create flow).
      match /family_members/{memberId} {
        allow read: if sameFamily(familyId);
        allow create: if signedIn() && request.auth.uid == memberId;
        allow update, delete: if signedIn() && request.auth.uid == memberId;
      }

      match /user_roles/{roleId} {
        allow read: if sameFamily(familyId);
        allow write: if signedIn() && request.auth.uid == roleId;
      }
    }

    match /{collection}/{docId} {
      allow read, write: if signedIn() &&
        collection in [
          "family_members",
          "parents",
          "emergency_contacts",
          "medicines",
          "medicine_logs",
          "appointments",
          "vitals",
          "sos_events",
          "media_posts",
          "notifications",
          "ai_conversations",
          "ai_messages",
          "subscriptions"
        ];
    }
  }
}
